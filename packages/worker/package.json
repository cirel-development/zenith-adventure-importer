{
  "name": "@ai-adventure/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 worker: PDF in, validated adventure bundle out",
  "bin": {
    "zenith-worker": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/cli.ts",
    "process": "tsx src/cli.ts process",
    "prepare:sim": "tsx src/cli.ts prepare",
    "assemble:sim": "tsx src/cli.ts assemble",
    "test:bundle": "tsx tests/build-test-bundle.ts",
    "test:chapters": "tsx tests/assemble-chapters.check.ts",
    "build:index": "tsx scripts/build-compendium-index.ts",
    "test:index": "tsx tests/compendium-index.check.ts",
    "test:match": "tsx tests/match.check.ts",
    "test:items": "tsx tests/items.check.ts",
    "test:statblocks": "tsx tests/statblock-accuracy.ts",
    "test:statblock": "tsx tests/statblock.check.ts",
    "test:link": "tsx tests/link.check.ts",
    "test:inventory": "tsx tests/inventory.check.ts",
    "test:abilities": "tsx tests/abilities.check.ts",
    "test:hazards": "tsx tests/hazards.check.ts",
    "test:spells": "tsx tests/spells.check.ts",
    "test:fallback": "tsx tests/fallback.check.ts",
    "test:grid": "tsx tests/grid.check.ts",
    "list:maps": "tsx scripts/list-maps.ts",
    "test:scenes": "tsx tests/scenes.check.ts"
  },
  "dependencies": {
    "@ai-adventure/contract": "workspace:*",
    "@anthropic-ai/sdk": "^0.30.1",
    "dotenv": "^16.4.5",
    "fflate": "^0.8.2",
    "jpeg-js": "^0.4.4",
    "pdfjs-dist": "^4.7.76",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
